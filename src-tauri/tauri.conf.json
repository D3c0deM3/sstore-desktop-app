{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SStore",
  "version": "0.1.0",
  "identifier": "uz.sstore.desktop",
  "build": {
    "beforeDevCommand": "npm run start:desktop",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SStore",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SStore",
    "category": "Business",
    "shortDescription": "Offline inventory and sales app",
    "longDescription": "SStore is an offline desktop inventory, sales, and debt tracking app."
  }
}
